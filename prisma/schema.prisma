// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int     @id @default(autoincrement())
  firstName String  @db.VarChar(100)
  lastName  String? @db.VarChar(100)
  // Authorization role (e.g. "admin"), read by RoleGuard to match against
  // the @Roles([...]) metadata on a route handler.
  // Nullable: existing rows predate this column, and a user without a role
  // simply fails every role-restricted route.
  role      String? @db.VarChar(50)

  @@map("users")
}
